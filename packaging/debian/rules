#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-3.0-or-later
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export CARGO_INCREMENTAL = 0
export CARGO_TARGET_DIR ?= target
CARGO_ARGS = --locked --offline --no-default-features --features imgur

%:
	dh $@ --buildsystem=none

override_dh_auto_build:
	cargo build $(CARGO_ARGS) --release -p flameshot

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cargo test $(CARGO_ARGS) --workspace
endif

override_dh_auto_install:
	DESTDIR="$(CURDIR)/debian/flameshot" PREFIX=/usr FLAMESHOT_BINARY="$(CARGO_TARGET_DIR)/release/flameshot" scripts/stage-rust.sh

override_dh_auto_clean:
	rm -rf target

# Debhelper must not rewrite or delete files covered by Cargo vendor checksums.
override_dh_update_autotools_config override_dh_autoreconf override_dh_autoreconf_clean:

override_dh_clean:
	dh_clean --exclude=vendor/
